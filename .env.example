# Application
NODE_ENV=development
APP_NAME=telegram-vpn-bot
APP_URL=http://localhost:3000
API_PORT=3000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vpn_bot
DB_POOL_MIN=5
DB_POOL_MAX=50

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=vpn_bot:

# Marzban API
MARZBAN_API_URL=https://marzban.example.com
MARZBAN_ADMIN_USERNAME=admin
MARZBAN_ADMIN_PASSWORD=admin_password
MARZBAN_TIMEOUT=30000
MARZBAN_RETRY_ATTEMPTS=3
MARZBAN_RETRY_DELAY=1000

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234...
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook
TELEGRAM_ADMIN_IDS=123456789,987654321
TELEGRAM_LOG_CHANNEL_ID=-1001234567890

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Payment Providers
CRYPTOPAY_API_KEY=your_cryptopay_api_key
CRYPTOPAY_WEBHOOK_SECRET=
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_API_IPN_SECRET=
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_ADMIN_MAX_REQUESTS=100

# GraphQL
GRAPHQL_PLAYGROUND=true
GRAPHQL_INTROSPECTION=true

# Workers
CONCURRENCY_PAYMENT_WORKER=5
CONCURRENCY_MARZBAN_WORKER=10
CONCURRENCY_NOTIFICATION_WORKER=20
CONCURRENCY_SCHEDULED_WORKER=3

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Feature Flags
ENABLE_TEST_ACCOUNTS=true
ENABLE_GIFT_CODES=true
ENABLE_RESELLER_SYSTEM=true
ENABLE_REFERRAL_SYSTEM=true
ENABLE_SMART_ALERTS=true
